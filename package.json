{
	"name": "evilarme",
	"packageManager": "pnpm@10.32.1",
	"type": "module",
	"version": "1.0.0",
	"private": false,
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"prebuild": "pnpm check:routes",
		"build": "astro build",
		"postbuild": "pnpm check:og && pagefind --site dist --root-selector \"[data-pagefind-body]\"",
		"preview": "astro preview",
		"lint": "biome lint .",
		"format": "pnpm run format:code && pnpm run format:imports",
		"format:code": "biome format . --write && prettier -w \"**/*\" \"!**/*.{md,mdx}\" --ignore-unknown --cache",
		"format:imports": "biome check --formatter-enabled=false --write",
		"check": "astro check",
		"check:og": "node --import tsx scripts/check-social-images.ts",
		"check:routes": "node --import tsx scripts/check-content-routes.ts",
		"media:photos": "tsx scripts/process-photos.ts",
		"prepare": "simple-git-hooks"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.2.1",
		"@astrojs/mdx": "^7.0.3",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.3",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.2.2",
		"astro-expressive-code": "^0.44.1",
		"astro-icon": "^1.1.5",
		"astro-robots-txt": "^1.0.0",
		"hastscript": "^9.0.1",
		"mdast-util-directive": "^3.1.0",
		"mdast-util-to-markdown": "^2.1.2",
		"mdast-util-to-string": "^4.0.0",
		"rehype-autolink-headings": "^7.1.0",
		"rehype-external-links": "^3.0.0",
		"rehype-unwrap-images": "^1.0.0",
		"remark-directive": "^4.0.0",
		"sharp": "^0.35.3",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@biomejs/biome": "^2.5.5",
		"@iconify-json/mdi": "^1.2.3",
		"@iconify-json/mingcute": "^1.2.7",
		"@pagefind/component-ui": "^1.5.2",
		"@tailwindcss/typography": "^0.5.20",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"blurhash": "^2.0.5",
		"exifr": "^7.1.3",
		"pagefind": "^1.5.2",
		"prettier": "^3.9.6",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"reading-time": "^1.5.0",
		"simple-git-hooks": "^2.13.1",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@biomejs/biome",
			"@tailwindcss/oxide",
			"esbuild",
			"sharp",
			"simple-git-hooks"
		]
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm check:routes"
	}
}
