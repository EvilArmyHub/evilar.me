---
import { ClientRouter } from "astro:transitions";
import BaseHead from "@/components/BaseHead.astro";
import Footer from "@/components/layout/Footer.astro";
import Header from "@/components/layout/Header.astro";
import SkipLink from "@/components/SkipLink.astro";
import ThemeProvider from "@/components/ThemeProvider.astro";
import { siteConfig } from "@/site.config";
import type { SiteMeta } from "@/types";

interface Props {
	meta: SiteMeta;
	isArticleLayout?: boolean;
	doNotIndex?: boolean;
}

const {
	meta: { articleDate, description = siteConfig.description, ogImage, title, author },
	isArticleLayout = false,
	doNotIndex = false,
} = Astro.props;
---

<html
	class="scroll-smooth"
	lang={siteConfig.lang}
	{...(doNotIndex ? { "data-pagefind-ignore": "all" } : {})}
>
	<head>
		<ThemeProvider />
		<BaseHead
			articleDate={articleDate}
			description={description}
			ogImage={ogImage}
			title={title}
			author={author}
		/>
		<ClientRouter />
	</head>
	<body
		class:list={[
			"bg-bg text-text mx-auto flex min-h-screen max-w-3xl flex-col px-4 font-sans text-base font-normal antialiased sm:px-8",
			isArticleLayout ? "pt-6 sm:pt-5" : "pt-6 sm:pt-8",
		]}
	>
		<SkipLink />
		<Header isCompact={isArticleLayout} />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<script is:inline type="speculationrules">
			{
				"prefetch": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "immediate"
					}
				],
				"prerender": [
					{
						"where": {
							"href_matches": "/*"
						},
						"eagerness": "moderate"
					}
				]
			}
		</script>
		<script>
			function initBenchmarkTables() {
				const tables = document.querySelectorAll<HTMLElement>(".benchmark-scroll");
				if (!tables.length) return;

				for (const scrollArea of tables) {
					if (scrollArea.dataset.initialized === "true") continue;
					scrollArea.dataset.initialized = "true";

					const benchmark = scrollArea.closest<HTMLElement>(".benchmark");
					if (!benchmark) continue;

					const updateState = () => {
						const overflows = scrollArea.scrollWidth > scrollArea.clientWidth + 1;
						const atEnd =
							scrollArea.scrollLeft + scrollArea.clientWidth >= scrollArea.scrollWidth - 1;

						benchmark.dataset.overflow = String(overflows);
						benchmark.dataset.atEnd = String(!overflows || atEnd);
						if (overflows) scrollArea.tabIndex = 0;
						else scrollArea.removeAttribute("tabindex");
					};

					scrollArea.addEventListener("scroll", updateState, { passive: true });
					new ResizeObserver(updateState).observe(scrollArea);
					requestAnimationFrame(updateState);
				}
			}

			document.addEventListener("astro:page-load", initBenchmarkTables);
		</script>
		<script>
			console.log(
				"%c👁 if you gaze long into an abyss, the abyss also gazes at you",
				"color: #888; font-size: 14px; font-family: monospace;",
			);
		</script>
	</body>
</html>
