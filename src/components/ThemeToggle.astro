---
import { Icon } from "astro-icon/components";

interface Props {
	isCompact?: boolean;
	class?: string;
	showText?: boolean;
}

const { isCompact = false, class: className = "", showText = false } = Astro.props;
---

<theme-toggle class:list={["ms-2 sm:ms-4", isCompact && "sm:ms-3", className || "inline-flex"]}>
	{showText ? (
		<button
			class="mobile-nav-link nav-link flex w-full cursor-pointer items-center rounded-lg border-none bg-transparent px-3 py-2 text-left text-[0.9375rem] font-medium transition-all duration-200 focus-visible:outline-none"
			type="button"
		>
			<span class="sr-only">Переключить тему</span>
			<div class="relative me-2.5 h-5 w-5 shrink-0">
				<Icon
					aria-hidden="true"
					class="absolute start-1/2 top-1/2 h-5 w-5 -translate-x-1/2 -translate-y-1/2 scale-100 opacity-100 transition-all dark:scale-0 dark:opacity-0"
					focusable="false"
					name="ph:sun"
				/>
				<Icon
					aria-hidden="true"
					class="absolute start-1/2 top-1/2 h-5 w-5 -translate-x-1/2 -translate-y-1/2 scale-0 opacity-0 transition-all dark:scale-100 dark:opacity-100"
					focusable="false"
					name="ph:moon-stars"
				/>
			</div>
			<span class="select-none">Тема</span>
		</button>
	) : (
		<button class="header-action-btn" type="button">
			<span class="sr-only">Переключить тему</span>
			<Icon
				aria-hidden="true"
				class:list={[
					"absolute start-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 scale-100 opacity-100 transition-all dark:scale-0 dark:opacity-0",
					isCompact ? "h-7 w-7 sm:h-6 sm:w-6" : "h-7 w-7",
				]}
				focusable="false"
				name="ph:sun"
			/>
			<Icon
				aria-hidden="true"
				class:list={[
					"absolute start-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 scale-0 opacity-0 transition-all dark:scale-100 dark:opacity-100",
					isCompact ? "h-7 w-7 sm:h-6 sm:w-6" : "h-7 w-7",
				]}
				focusable="false"
				name="ph:moon-stars"
			/>
		</button>
	)}
</theme-toggle>

<script>
	import {
		dispatchThemeChange,
		rootInDarkMode,
		THEME_APPLIED_EVENT,
		type ThemePreference,
	} from "@/utils/theme";

	class ThemeToggle extends HTMLElement {
		#button: HTMLButtonElement | null = null;
		#onThemeApplied = () => {
			this.#button?.setAttribute("aria-checked", String(rootInDarkMode()));
		};

		connectedCallback() {
			this.#button = this.querySelector<HTMLButtonElement>("button");

			if (!this.#button) {
				console.warn("Theme toggle button not found");
				return;
			}

			this.#button.setAttribute("role", "switch");
			this.#button.setAttribute("aria-checked", String(rootInDarkMode()));
			this.#button.addEventListener("click", this.#onClick);
			document.addEventListener(THEME_APPLIED_EVENT, this.#onThemeApplied);
		}

		disconnectedCallback() {
			this.#button?.removeEventListener("click", this.#onClick);
			document.removeEventListener(THEME_APPLIED_EVENT, this.#onThemeApplied);
		}

		#onClick = () => {
			const nextTheme: ThemePreference = rootInDarkMode() ? "light" : "dark";
			dispatchThemeChange({ theme: nextTheme });
		};
	}

	if (!customElements.get("theme-toggle")) {
		customElements.define("theme-toggle", ThemeToggle);
	}
</script>
