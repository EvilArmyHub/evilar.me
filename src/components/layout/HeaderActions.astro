---
import { Icon } from "astro-icon/components";
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";

interface Props {
	isCompact?: boolean;
	menuId: string;
}

const { isCompact = false, menuId } = Astro.props;
---

<Search isCompact={isCompact} />
<ThemeToggle isCompact={isCompact} class="hidden sm:inline-flex" />
<mobile-nav-toggle class="inline-flex sm:hidden">
	<button
		aria-controls={menuId}
		aria-expanded="false"
		aria-haspopup="menu"
		class:list={["header-action-btn group ms-4 sm:invisible sm:hidden"]}
		type="button"
	>
		<span class="sr-only">Открыть главное меню</span>
		<Icon
			aria-hidden="true"
			class="absolute start-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 transition-all group-aria-expanded:scale-0 group-aria-expanded:opacity-0"
			focusable="false"
			name="ph:list"
		/>
		<Icon
			aria-hidden="true"
			class="text-accent absolute start-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 scale-0 opacity-0 transition-all group-aria-expanded:scale-100 group-aria-expanded:opacity-100"
			focusable="false"
			name="ph:x"
		/>
	</button>
</mobile-nav-toggle>

<script>
	import "@/scripts/mobile-nav-toggle";
</script>
