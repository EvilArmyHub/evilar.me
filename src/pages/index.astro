---
import ActionLink from "@/components/ActionLink.astro";
import AnniversaryWidget from "@/components/AnniversaryWidget.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import EvilIllustration from "@/components/EvilIllustration.astro";
import Note from "@/components/note/Note.astro";
import SocialList from "@/components/SocialList.astro";
import { getAllNotes, getLatestNotes } from "@/data/note";
import { getAllPosts, getPinnedPosts, getSortedPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

// Restrict displayed posts to maintain optimal page loading speed.
const MAX_POSTS = 10;
const allPosts = await getAllPosts();
const allPostsByDate = getSortedPosts(allPosts);
const latestPosts = allPostsByDate.slice(0, MAX_POSTS);

// Pin a small curated subset of posts to keep critical announcement or key items visible above the fold.
const MAX_PINNED_POSTS = 3;
const pinnedPosts = getPinnedPosts(allPostsByDate, MAX_PINNED_POSTS);

// Cap notes to avoid cluttering the home dashboard layout with micro-blogging content.
const MAX_NOTES = 5;
const allNotes = await getAllNotes();
const latestNotes = getLatestNotes(allNotes, MAX_NOTES);

function pluralizeRu(count: number, one: string, few: string, many: string) {
	const mod10 = count % 10;
	const mod100 = count % 100;

	if (mod10 === 1 && mod100 !== 11) {
		return one;
	}

	if (mod10 >= 2 && mod10 <= 4 && (mod100 < 12 || mod100 > 14)) {
		return few;
	}

	return many;
}

const remainingPosts = Math.max(allPostsByDate.length - latestPosts.length, 0);
const remainingNotes = Math.max(allNotes.length - latestNotes.length, 0);
const showPostsLink = remainingPosts > 0;
const postsLinkText = showPostsLink
	? `еще ${remainingPosts} ${pluralizeRu(remainingPosts, "статья", "статьи", "статей")}`
	: "";
const notesLinkText =
	remainingNotes > 0
		? `еще ${remainingNotes} ${pluralizeRu(remainingNotes, "заметка", "заметки", "заметок")}`
		: "все заметки";
---

<PageLayout meta={{ title: "Главная" }} doNotIndex>
	<section
		class="h-card grid grid-cols-1 gap-y-6 sm:grid-cols-[1fr_auto] sm:items-center sm:gap-x-8"
	>
		<a class="u-url hidden" href="/">Evil Army</a>
		<img
			class="u-photo u-logo hidden"
			data-image-component="true"
			loading="eager"
			src="/icon.svg"
			alt="Evil Army Logo"
		/>
		<div>
			<h1 class="p-name title mb-3 text-2xl font-semibold sm:text-3xl">Ламповый чат</h1>
			<p class="p-note mt-0 mb-3">
				Разношёрстное и живое комьюнити с 2018. Обсуждаем всё: нейросети, игры, науку, работу,
				учёбу, религию и жизнь
			</p>
			<p class="mb-4">
				Пишем 1500+ сообщений в день, 💫 уникальный и ~постоянный состав из разных стран. Студенты,
				программисты, музыканты и кого только нет
			</p>
			<SocialList />
		</div>
		<div class="flex w-full flex-shrink-0 items-center justify-center sm:h-[20rem] sm:w-auto">
			<EvilIllustration class="text-text h-auto w-full max-w-full sm:h-full sm:w-auto" />
		</div>
	</section>
	{
		pinnedPosts.length > 0 && (
			<section class="mt-10">
				<h2 class="page-title mb-3 text-xl">Ключевое</h2>
				<div class="relative" data-post-hover-container>
					<ul class="space-y-1" role="list">
						{pinnedPosts.map((p) => (
							<li>
								<PostPreview post={p} />
							</li>
						))}
					</ul>
					<div
						class="post-hover-card bg-bg pointer-events-none absolute top-0 right-0 z-30 hidden aspect-[1200/630] w-60 overflow-hidden rounded-[10px] shadow-xl shadow-black/5 md:block dark:shadow-black/20"
						data-post-hover-card
					>
						<img
							src=""
							alt=""
							decoding="async"
							data-image-component="true"
							class="h-full w-full object-cover"
							data-post-hover-image
						/>
					</div>
				</div>
			</section>
		)
	}
	<section class="mt-10">
		<h2 class="page-title mb-3 text-xl">Статьи</h2>
		<div class="relative" data-post-hover-container>
			<ul class="space-y-1" role="list">
				{
					latestPosts.map((p) => (
						<li>
							<PostPreview post={p} />
						</li>
					))
				}
			</ul>
			<div
				class="post-hover-card bg-bg pointer-events-none absolute top-0 right-0 z-30 hidden aspect-[1200/630] w-60 overflow-hidden rounded-[10px] shadow-xl shadow-black/5 md:block dark:shadow-black/20"
				data-post-hover-card
			>
				<img
					src=""
					alt=""
					decoding="async"
					data-image-component="true"
					class="h-full w-full object-cover"
					data-post-hover-image
				/>
			</div>
		</div>
		{
			showPostsLink && (
				<ActionLink class="mt-4" href="/posts/">
					{postsLinkText}
				</ActionLink>
			)
		}
	</section>
	{
		latestNotes.length > 0 && (
			<section class="mt-10">
				<h2 class="page-title mb-3 text-xl">Заметки</h2>
				<ul class="space-y-4" role="list">
					{latestNotes.map((note) => (
						<li>
							<Note note={note} as="h3" isPreview isHome />
						</li>
					))}
				</ul>
				<ActionLink class="mt-4" href="/notes/">
					{notesLinkText}
				</ActionLink>
			</section>
		)
	}
	<AnniversaryWidget />
</PageLayout>

<style>
	.post-hover-card {
		opacity: 0;
		transform: translateY(var(--preview-y, 0px)) scale(0.96);
		transition:
			opacity 180ms ease-out,
			transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
	}

	.post-hover-card.is-visible {
		opacity: 1;
		transform: translateY(var(--preview-y, 0px)) scale(1);
	}
</style>

<script>
	function setupPostHoverPreviews() {
		const containers = document.querySelectorAll<HTMLElement>("[data-post-hover-container]");
		if (!containers.length) return;

		const isHoverSupported = window.matchMedia("(hover: hover) and (pointer: fine)").matches;
		if (!isHoverSupported) return;

		const allLinks = document.querySelectorAll<HTMLAnchorElement>("a[data-preview-image]");
		const preloadImages = () => {
			for (const link of allLinks) {
				const previewUrl = link.dataset.previewImage;
				if (previewUrl) {
					const img = new Image();
					img.src = previewUrl;
				}
			}
		};

		if ("requestIdleCallback" in window) {
			window.requestIdleCallback(preloadImages);
		} else {
			setTimeout(preloadImages, 200);
		}

		for (const container of containers) {
			const card = container.querySelector<HTMLElement>("[data-post-hover-card]");
			const image = container.querySelector<HTMLImageElement>("[data-post-hover-image]");
			if (!card || !image) continue;

			const links = container.querySelectorAll<HTMLAnchorElement>("a[data-preview-image]");
			if (!links.length) continue;

			let activeLink: HTMLAnchorElement | null = null;

			const updatePosition = (link: HTMLAnchorElement) => {
				const containerRect = container.getBoundingClientRect();
				const linkRect = link.getBoundingClientRect();
				const cardHeight = card.offsetHeight;
				const containerHeight = container.offsetHeight;

				const linkRelativeTop = linkRect.top - containerRect.top;
				const linkCenterY = linkRelativeTop + linkRect.height / 2;
				let targetY = linkCenterY - cardHeight / 2;

				const maxTop = Math.max(0, containerHeight - cardHeight);
				targetY = Math.max(0, Math.min(targetY, maxTop));

				card.style.setProperty("--preview-y", `${Math.round(targetY)}px`);
			};

			const showPreview = (link: HTMLAnchorElement) => {
				activeLink = link;
				const previewUrl = link.dataset.previewImage;
				if (previewUrl && image.getAttribute("src") !== previewUrl) {
					image.src = previewUrl;
				}

				const wasVisible = card.classList.contains("is-visible");
				if (!wasVisible) {
					card.style.transition = "none";
					updatePosition(link);
					void card.offsetHeight;
					card.style.transition = "";
					card.classList.add("is-visible");
				} else {
					updatePosition(link);
				}
			};

			const hidePreview = () => {
				activeLink = null;
				card.classList.remove("is-visible");
			};

			for (const link of links) {
				link.addEventListener("pointerenter", () => showPreview(link));
				link.addEventListener("focus", () => showPreview(link));
				link.addEventListener("blur", hidePreview);
			}

			container.addEventListener("pointerleave", hidePreview);

			window.addEventListener("resize", () => {
				if (activeLink) {
					updatePosition(activeLink);
				}
			});
		}
	}

	document.addEventListener("astro:page-load", setupPostHoverPreviews);
</script>
